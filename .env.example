# Usage Metering & Billing Engine - environment template
#
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file or real Stripe credentials.

# Stripe (TEST MODE ONLY). Get these from the Stripe dashboard:
#   - STRIPE_SECRET_KEY: test key, e.g. sk_test_...
#   - STRIPE_WEBHOOK_SECRET: whsec_... shown when running `stripe listen`
#   - STRIPE_PRO_PRICE_ID: price id of the Pro plan price (starts with price_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_pro_test_placeholder

# Callback URLs used by Stripe Checkout.
STRIPE_SUCCESS_URL=http://localhost:8000/billing/success
STRIPE_CANCEL_URL=http://localhost:8000/billing/cancel

# Database connection.
DATABASE_URL=sqlite:///./metering.db

# Background rollup job interval (seconds).
ROLLUP_INTERVAL_SECONDS=60
